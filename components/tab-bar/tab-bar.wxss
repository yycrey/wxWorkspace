.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
  color: #667eea;
}

.tab-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  transition: all 0.2s;
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  transition: all 0.2s;
}

.tab-item.active {
  transform: scale(1.05);
}
