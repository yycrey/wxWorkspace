.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

/* 导航栏 */
.nav-bar {
  flex-shrink: 0;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: content-box;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a202c;
}

/* 滚动区域 */
.bg-scroll {
  flex: 1;
  height: 0;
  padding: 30rpx;
}

/* 标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a202c;
  margin-bottom: 24rpx;
  margin-top: 30rpx;
}

.section-title:first-child {
  margin-top: 0;
}

/* 当前背景 */
.current-section {
  margin-bottom: 20rpx;
}

.current-bg {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.bg-image {
  width: 100%;
  height: 100%;
}

/* 背景网格 */
.bg-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.bg-item {
  position: relative;
  width: calc(50% - 10rpx);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.bg-item.active {
  border-color: #667eea;
}

.bg-thumb {
  width: 100%;
  height: 100%;
}

.selected-icon {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
}

.delete-btn {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(229, 62, 62, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
}

/* 上传按钮 */
.upload-btn {
  width: calc(50% - 10rpx);
  height: 200rpx;
  background: #f7fafc;
  border: 2rpx dashed #d1d5db;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-btn:active {
  border-color: #667eea;
  background: #f0f4ff;
}

.upload-icon {
  font-size: 60rpx;
  color: #667eea;
  line-height: 1;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #718096;
}
