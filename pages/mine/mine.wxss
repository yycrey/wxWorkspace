.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

/* 导航栏 */
.nav-bar {
  flex-shrink: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-sizing: content-box;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 内容滚动区域 */
.content-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx;
  padding-bottom: 140rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 50rpx 30rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
}

/* 用户资料区域 */
.user-profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
}

/* 用户信息容器 */
.user-info-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 用户姓名 */
.user-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
}

/* 用户ID */
.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 30rpx;
  border-radius: 25rpx;
}

/* 未登录状态容器 */
.unlogin-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

/* 登录按钮 */
.unlogin-container .login-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 30rpx 50rpx;
  margin: 0;
  line-height: normal;
}

.unlogin-container .login-btn::after {
  border: none;
}

.unlogin-container .login-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

/* 登录头像 */
.login-avatar {
  margin-bottom: 20rpx;
}

/* 未登录头像占位 */
.user-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.15);
}

.avatar-text {
  font-size: 56rpx;
}

.login-tip {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.login-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 功能菜单 */
.menu-section {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-title {
  font-size: 26rpx;
  color: #a0aec0;
  padding: 24rpx 30rpx 16rpx;
  background: #f8fafc;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.menu-item:first-of-type {
  border-top: none;
}

.menu-item:active {
  background: #f7fafc;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #1a202c;
}

.menu-arrow {
  font-size: 28rpx;
  color: #c0c0c0;
}

/* 关于信息 */
.about-section {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.about-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.about-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.about-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a202c;
  margin-bottom: 8rpx;
}

.about-version {
  font-size: 22rpx;
  color: #a0aec0;
}

/* 语言切换 */
.lang-picker {
  background: #f7fafc;
  border-radius: 16rpx;
  padding: 16rpx;
  margin: 0 32rpx 24rpx 32rpx;
}

.lang-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.lang-item:last-child {
  margin-bottom: 0;
}

.lang-item.active {
  background: #ebf4ff;
}

.lang-native {
  font-size: 28rpx;
  font-weight: 500;
  color: #2d3748;
  margin-right: 12rpx;
}

.lang-name {
  font-size: 24rpx;
  color: #a0aec0;
}

.lang-check {
  margin-left: auto;
  color: #667eea;
  font-size: 28rpx;
  font-weight: 600;
}
