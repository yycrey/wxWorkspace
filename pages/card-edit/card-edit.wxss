.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
}

/* 导航栏 */
.page::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  z-index: 0;
}

/* 导航栏 */
.nav-bar {
  flex-shrink: 0;
  background: rgba(102, 126, 234, 0.95);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 2;
  box-sizing: content-box;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}

.nav-back {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back:active {
  opacity: 0.7;
}

.back-icon {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  text-align: center;
  flex: 1;
  white-space: nowrap;
}

.nav-placeholder {
  width: 60rpx;
}

/* 表单滚动区域 */
.form-scroll {
  flex: 1;
  height: 0;
  padding: 30rpx 0;
}

/* 表单容器 - 居中显示 */
.form-container {
  max-width: 690rpx;
  margin: 0 auto;
}

/* 头像/形象照上传控件（方形，类似名片背景样式） */
.avatar-form-item {
  margin-bottom: 36rpx;
}

.avatar-upload-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 4rpx solid #e2e8f0;
  box-sizing: border-box;
  background: #f7fafc;
  position: relative;
}

.avatar-upload-box:active {
  border-color: #667eea;
  opacity: 0.85;
}

.avatar-upload-img {
  width: 100%;
  height: 100%;
}

.avatar-upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7fafc;
}

.av-upl-icon {
  font-size: 64rpx;
  color: #667eea;
  line-height: 1;
  margin-bottom: 12rpx;
}

.av-upl-text {
  font-size: 24rpx;
  color: #718096;
  font-weight: 500;
}

/* 表单区块 */
.form-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a202c;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
}

.form-hint {
  font-size: 24rpx;
  font-weight: normal;
  color: #a0aec0;
  margin-left: 12rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 36rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #4a5568;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 96rpx;
  background: #f7fafc;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1a202c;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #a0aec0;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  height: 240rpx;
  background: #f7fafc;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
  color: #1a202c;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-textarea::placeholder {
  color: #a0aec0;
}

/* ===== 实时名片预览（表单内） ===== */

.bottom-bar-content {
  max-width: 690rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 96rpx;
  background: #f7fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 48rpx;
}

.back-btn:active {
  background: #e2e8f0;
}

.back-icon {
  font-size: 32rpx;
  color: #4a5568;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #4a5568;
}

.save-btn {
  flex: 1;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
}

.save-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 底部操作栏 */
.bottom-bar {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.95);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* ===== 名片背景选择（横向滚动） ===== */
.bg-section {
  margin-top: 30rpx;
}

.bg-section .form-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bg-clear-btn {
  padding: 6rpx 20rpx;
  background: #fee2e2;
  border-radius: 24rpx;
}

.bg-clear-btn:active {
  background: #fecaca;
}

.bg-clear-text {
  font-size: 24rpx;
  color: #dc2626;
  font-weight: 500;
}

.bg-scroll-x {
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
}

.bg-scroll-inner {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.bg-x-item {
  position: relative;
  flex: 0 0 auto;
  width: 130rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.bg-x-item.active {
  border-color: #667eea;
}

.bg-x-item:active {
  opacity: 0.85;
}

.bg-x-thumb {
  width: 100%;
  height: 100%;
}

.bg-x-check {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 28rpx;
  height: 28rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: bold;
}

.bg-x-none {
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
}

.bg-x-none-inner {
  width: 100%;
  height: 100%;
  background: #f7fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bg-x-none-icon {
  font-size: 56rpx;
  color: #a0aec0;
  margin-bottom: 10rpx;
}

.bg-x-none-txt {
  font-size: 24rpx;
  color: #a0aec0;
  font-weight: 500;
}

.bg-x-upload {
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
}

.bg-x-upload-inner {
  width: 100%;
  height: 100%;
  background: #f7fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bg-x-upload-inner:active {
  background: #f0f4ff;
}

.bg-x-upload-icon {
  font-size: 56rpx;
  color: #667eea;
  line-height: 1;
  margin-bottom: 10rpx;
}

.bg-x-upload-txt {
  font-size: 24rpx;
  color: #718096;
  font-weight: 500;
}

/* ===== 实时名片预览（表单内） ===== */
.live-card-preview {
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.12);
}

.live-card-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.95);
  min-height: 200rpx;
}

.live-bg-overlay {
  background: rgba(255, 255, 255, 0.85);
}

.live-card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.live-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
  border: 3rpx solid #e8f0fe;
}

.live-avatar-img {
  width: 100%;
  height: 100%;
}

.live-avatar-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.live-info {
  flex: 1;
  min-width: 0;
}

.live-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 4rpx;
}

.live-position {
  display: block;
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 4rpx;
}

.live-company {
  display: inline-block;
  font-size: 22rpx;
  color: #1a73e8;
  font-weight: 500;
  background: #e8f0fe;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
}

.live-card-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 20rpx;
  max-width: 200rpx;
}

.live-phone {
  display: block;
  font-size: 24rpx;
  color: #2d3748;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.live-wechat {
  display: block;
  font-size: 20rpx;
  color: #07c160;
  margin-bottom: 4rpx;
}

.live-industry {
  display: inline-block;
  font-size: 20rpx;
  color: #667eea;
  font-weight: 500;
  background: #eef0ff;
  padding: 2rpx 14rpx;
  border-radius: 14rpx;
  margin-top: 4rpx;
}

.live-address {
  display: block;
  font-size: 20rpx;
  color: #a0aec0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 180rpx;
}

/* ===== 表单底部保存按钮 ===== */
.form-bottom-save {
  padding: 20rpx 0 40rpx;
  display: flex;
  justify-content: center;
}

.form-save-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
}

.form-save-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.form-save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ===== 名片附件 ===== */
.attachment-list {
  margin-bottom: 24rpx;
}

.attachment-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f7fafc;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.attachment-item:active {
  background: #edf2f7;
}

.att-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.att-name {
  flex: 1;
  font-size: 26rpx;
  color: #2d3748;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.att-del {
  width: 44rpx;
  height: 44rpx;
  background: #fee2e2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #dc2626;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.att-del:active {
  background: #fecaca;
}

.upload-att-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #f7fafc;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
}

.upload-att-btn:active {
  border-color: #667eea;
  background: #f0f4ff;
}

.upload-att-icon {
  font-size: 40rpx;
  color: #667eea;
  margin-right: 12rpx;
}

.upload-att-text {
  font-size: 26rpx;
  color: #718096;
  font-weight: 500;
}
