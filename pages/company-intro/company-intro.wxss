.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

/* 导航栏 */
.nav-bar {
  flex-shrink: 0;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: content-box;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a202c;
}

/* 表单滚动区域 */
.form-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx;
}

/* 表单区块 */
.form-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a202c;
  margin-bottom: 20rpx;
}

.form-textarea {
  width: 100%;
  height: 400rpx;
  background: #f7fafc;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1a202c;
  box-sizing: border-box;
  line-height: 1.8;
}

.form-textarea::placeholder {
  color: #a0aec0;
}

.form-hint {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #a0aec0;
  margin-top: 12rpx;
}

/* 提示区域 */
.tip-section {
  margin-top: 30rpx;
  padding: 0 20rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

/* 底部操作栏 */
.bottom-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 96rpx;
  background: #f7fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 48rpx;
}

.back-btn:active {
  background: #e2e8f0;
}

.back-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #4a5568;
}

.save-btn {
  flex: 1;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
}

.save-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}
